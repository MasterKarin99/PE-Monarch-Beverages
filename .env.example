# Nom de domaine de la plateforme (doit pointer vers ce serveur), sans https://
DOMAIN=plannings.monarchbeverages.com

# Équipe avec accès complet (adresses séparées par des virgules, et/ou domaine)
ADMIN_EMAILS=contact20@exemple.example
# ADMIN_DOMAINS=monarchbeverages.com

# Durée de connexion (jours)
SESSION_DAYS=30

# Facultatif : serveur d'envoi pour que chacun reçoive lui-même son lien de connexion.
# Sans ces paramètres, l'équipe génère les liens dans l'onglet Contacts (bouton « Liens d'accès »).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Plannings éditoriaux <contact36@exemple.example>

# Espace affiché dans l'onglet Téléchargements (octets)
# STORAGE_QUOTA_BYTES=10737418240
